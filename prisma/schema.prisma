generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum DomainType {
  TECHNICAL
  MANAGEMENT
  DESIGN
  MARKETING
  R_AND_D
  EDITORIAL
}

enum Role {
  DOMAIN_HEAD
  ROOT_ADMIN
}

// 1 form filling, 2 shortlisted, 3 slot choosing, 4 interview, 5 selected
enum Stage {
  FORM_FILLING
  SHORTLISTED
  SLOT_CHOOSING
  INTERVIEW
  SELECTED
  REJECTED
}

enum EmailType {
  SHORTLISTED
  MEETING_LINK
  SELECTED
  REJECTED
  GENERAL
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

model Admin {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  name         String?
  email        String     @unique
  password     String?
  role         Role       @default(DOMAIN_HEAD)
  domain       DomainType?
  slotsCreated Slot[]     @relation("AdminSlots")
}

model User {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String        @unique
  phone        String
  regNumber    String        @unique
  image        String?
  passwordHash String?       // bcrypt hash, set at sign up
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  answers      Answer[]
  applications Application[]
}

// One row per candidate per domain
model Application {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  domain      DomainType
  stage       Stage    @default(FORM_FILLING)
  submittedAt DateTime?
  createdAt   DateTime @default(now())

  review1Marks    Int?
  review1Comments String?
  review1Passed   Boolean @default(false)
  review2Marks    Int?
  review2Comments String?
  review2Passed   Boolean @default(false)

  userId  String   @db.ObjectId
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking SlotBooking?
  emails  EmailLog[]

  @@unique([userId, domain])
  @@index([domain, stage])
}

model Subsection {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  domain    DomainType
  name      String
  order     Int        @default(0)
  questions Question[]

  @@index([domain])
}

model Question {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  domain       DomainType
  subsectionId String?     @db.ObjectId
  subsection   Subsection? @relation(fields: [subsectionId], references: [id])
  text         String
  maxMarks     Int         @default(10)
  order        Int         @default(0)
  required     Boolean     @default(true)
  maxLength    Int         @default(2000)
  answers      Answer[]

  @@index([domain])
}

model Answer {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  text       String
  marks      Int?
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String   @db.ObjectId
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  updatedAt  DateTime @updatedAt

  @@unique([userId, questionId])
}

model Slot {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  domain        DomainType
  startTime     DateTime
  endTime       DateTime
  meetingLink   String?
  capacity      Int           @default(1)
  bookedCount   Int           @default(0)
  interviewerId String        @db.ObjectId
  interviewer   Admin         @relation("AdminSlots", fields: [interviewerId], references: [id])
  bookings      SlotBooking[]

  @@index([domain, startTime])
}

model SlotBooking {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  applicationId String      @unique @db.ObjectId
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  slotId        String      @db.ObjectId
  slot          Slot        @relation(fields: [slotId], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now())

  @@index([slotId])
}

model EmailLog {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  applicationId String      @db.ObjectId
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          EmailType
  status        EmailStatus @default(PENDING)
  attempts      Int         @default(0)
  error         String?
  sentAt        DateTime?
  createdAt     DateTime    @default(now())

  @@index([applicationId, type])
}

model RecruitmentConfig {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  key          String   @unique @default("main")
  isOpen       Boolean  @default(true)
  formDeadline DateTime
  updatedAt    DateTime @updatedAt
}
