# Database & Authentication
# The shared database used by both the admin and student backends
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.edw0occ.mongodb.net/recruitment?retryWrites=true&w=majority"
# Signs admin login tokens and setup codes. Required. Use a long random value that is DIFFERENT from
# the student backend's JWT_SECRET. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# Admin frontend address(es) allowed to call this backend, comma separated
CORS_ORIGIN=http://localhost:3000

# Recruitment Portal - Emailer Environment Variables
# Gmail address used to send emails
EMAIL_USER=your_club_email@gmail.com

# 16-character Google App Password (NOT your personal Gmail login password)
# Generate from: Google Account -> Security -> 2-Step Verification -> App Passwords
EMAIL_APP_PASSWORD=your_app_password_here

# Optional: Custom From address display
EMAIL_FROM="Club Recruitment Team <your_club_email@gmail.com>"

# Optional: Custom Reply-To address
EMAIL_REPLY_TO=your_club_email@gmail.com

# Port for the server
PORT=3000
