# Optional: Custom From address display
EMAIL_FROM="Club Recruitment Team <jhon.doe2023@gmail.com>"

# Optional: Custom Reply-To address
EMAIL_REPLY_TO=jhon.doe2023@gmail.com

# Port for the server
PORT=3000